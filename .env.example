# Copy this file to .env before running `docker compose up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=store_saas
POSTGRES_PORT=5432

# The api service's actual runtime database connection uses a separate,
# restricted role (app_runtime), not POSTGRES_USER above - postgres is a
# superuser, and superusers unconditionally bypass Row-Level Security on
# `products` regardless of policy. Created automatically by
# db/init/01-create-app-runtime-role.sql on postgres's first boot (only -
# an existing data volume needs `docker compose down -v` first for this to
# take effect). See docs/ARCHITECTURE.md §20's RLS section.
APP_RUNTIME_DB_PASSWORD=app_runtime_pw

# Required at runtime once QueueModule (background email queue) and
# TenantContextModule (RLS session context) are in the boot path - not
# optional. docker-compose points this at the redis service automatically.
REDIS_PORT=6379

API_PORT=3000
WEB_PORT=3001
# Must be reachable from the BROWSER (your host machine), not from inside the
# Docker network - so this stays http://localhost:3000, matching API_PORT
# above, even though the containers also talk to each other internally.
NEXT_PUBLIC_API_URL=http://localhost:3000

MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
MAIL_FROM=no-reply@store-saas.local

# "mailhog" (default) needs nothing further - docker-compose points it at
# the mailhog service automatically. Switch to "smtp" only once you've
# filled in SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD below with a real
# provider's values (SendGrid, Postmark, SES, etc - see docs/ARCHITECTURE.md
# §11). Leave SMTP_HOST/SMTP_PORT blank to keep using mailhog even with
# MAIL_TRANSPORT=smtp set - they're only read when actually switching.
MAIL_TRANSPORT=mailhog
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Leave unset for any real provider. Only "false" for an internal/
# self-hosted relay on a self-signed cert - never for a public provider.
SMTP_TLS_REJECT_UNAUTHORIZED=

# "local" (default) needs nothing further - uploads are served from the API
# container's own disk. Switch to "s3" only once you've filled in the S3
# vars below (see docs/ARCHITECTURE.md §10).
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
# Leave unset for real AWS S3. Set for R2/Spaces/MinIO/etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# "mock" (default) upgrades plans instantly, no external account needed.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Use long, random values in any real deployment.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Origin allowed to call the API (the admin panel's URL).
CORS_ORIGIN=http://localhost:3001

# Base URL of the frontend, used to build links sent in emails (currently:
# the password-reset link). Same value as CORS_ORIGIN in local dev, but a
# distinct variable since it serves a different purpose. No trailing slash.
WEB_APP_URL=http://localhost:3001

# Whether auth cookies get the Secure flag (only sent over HTTPS). Keep
# false for local dev and the default docker-compose setup (both plain
# HTTP). Set true only once genuinely served over HTTPS - see
# docs/DEPLOYMENT.md.
COOKIE_SECURE=false

# Only read by `node dist/database/seed.js` (see README.md "Seed sample data").
# Optional - each falls back to the value on the right if unset.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_OWNER_EMAIL=demo-owner@example.com
SEED_DEMO_OWNER_PASSWORD=DemoPass123!
