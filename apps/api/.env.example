NODE_ENV=development
PORT=3000

# Postgres connection string. In docker-compose this points at the `postgres` service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_saas

# Required at runtime - QueueModule (background email queue) and
# TenantContextModule (Row-Level Security session context, see
# docs/ARCHITECTURE.md §20) both need a real Redis to boot, not just to
# use every feature. Point this at any local Redis (a plain `redis-server`
# binary is enough for local dev outside Docker - `docker compose up`
# handles this automatically via the redis service).
REDIS_URL=redis://localhost:6379

# For local development WITHOUT Docker, DATABASE_URL above (postgres
# superuser) is fine as-is - RLS enforcement on `products` specifically
# needs the restricted app_runtime role docker-compose.yml's postgres
# service creates automatically (see db/init/01-create-app-runtime-role.sql)
# and docs/ARCHITECTURE.md §20's RLS section explains; without it, RLS
# policies exist in the schema but the superuser connection bypasses them
# unconditionally, silently. Only relevant if you're testing RLS
# specifically outside Docker - normal feature development against
# DATABASE_URL as-is is unaffected either way.

# Use long, random values in any real deployment.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Origin allowed to call this API (the admin panel's URL).
CORS_ORIGIN=http://localhost:3001

# Base URL of the frontend, used to build links sent in emails (currently:
# the password-reset link). No trailing slash.
WEB_APP_URL=http://localhost:3001

# Whether auth cookies get the Secure flag (only sent over HTTPS). Keep
# false for local dev and the default docker-compose setup (both plain
# HTTP). Set true only once genuinely served over HTTPS - see
# docs/DEPLOYMENT.md. Getting this wrong in either direction breaks
# login: true on plain HTTP means the browser silently drops the cookie;
# false on real HTTPS just means an avoidable weakening, not breakage.
COOKIE_SECURE=false

# "mock" (default) needs nothing further and upgrades plans instantly with no
# external calls. Switch to "stripe" only once you've filled in the Stripe
# vars below with your own test-mode account.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Only read by `node dist/database/seed.js` (see README.md "Seed sample data").
# Optional - each falls back to the value on the right if unset. Override
# before seeding if you want different credentials from the start.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_OWNER_EMAIL=demo-owner@example.com
SEED_DEMO_OWNER_PASSWORD=DemoPass123!

# SMTP connection used by MailhogMailProvider (the local default) or
# SmtpMailProvider (MAIL_TRANSPORT=smtp, for a real provider - SendGrid,
# Postmark, SES, or any provider speaking standard SMTP over TLS). In
# docker-compose these point at the mailhog service; for local dev without
# Docker, point at any SMTP catcher (e.g. a local Mailhog binary) or a real
# SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@store-saas.local

# "mailhog" (default) needs nothing further. Switch to "smtp" only once
# you've filled in SMTP_USER/SMTP_PASSWORD below with a real provider's
# credentials - MailhogMailProvider hardcodes settings a real server will
# refuse (see docs/ARCHITECTURE.md §11).
MAIL_TRANSPORT=mailhog
SMTP_USER=
SMTP_PASSWORD=
# Leave unset for any real provider (SendGrid/SES/Postmark all present a
# CA-signed cert). Only set to "false" for an internal/self-hosted relay
# using a self-signed cert - never for a public provider.
SMTP_TLS_REJECT_UNAUTHORIZED=

# "local" (default) needs nothing further and serves uploads from the API
# container's own disk. Switch to "s3" only once you've filled in the S3
# vars below - works against real AWS S3, or (via S3_ENDPOINT) Cloudflare
# R2, DigitalOcean Spaces, MinIO, or anything else speaking the S3 API.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
# Leave unset for real AWS S3. Set for R2/Spaces/MinIO/etc.
S3_ENDPOINT=
# Leave both unset on real AWS to use the SDK's default credential chain
# (an IAM role, if this ever actually runs on AWS compute). R2/Spaces/MinIO
# don't have an IAM-role concept, so they need these set explicitly.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Defaults to the standard AWS virtual-hosted URL shape if unset. Set
# explicitly for R2/Spaces/MinIO, or if the bucket sits behind a CDN/custom
# domain.
S3_PUBLIC_URL_BASE=
